# 一键部署配置：复制为 .env 后修改（deploy.sh 首次运行会自动复制）

# ---- 站点入口 ----
# docker-compose.override.yml 仅绑定宿主回环地址；公网入口由 Nginx Proxy Manager 提供
HTTP_PORT=8080

# ---- 数据库（复用现有 mysql-common 容器）----
DB_HOST=mysql-common
DB_PORT=3306
DB_USER=zhongju
DB_PASSWORD=请改成强密码
DB_NAME=zhongju_cards

# MySQL 与 Nginx Proxy Manager 共用的桥接网络，按目标环境填写
SHARED_NETWORK=bridge-network

# 仅首次建库时使用；建库完成后可留空
MYSQL_ROOT_PASSWORD=

# ---- 双口令（务必改掉默认值）----
STAFF_TOKEN=请改成业务员口令
ADMIN_TOKEN=请改成管理员口令
# token 签名密钥，建议填 32 位随机字符串：openssl rand -hex 16
TOKEN_SECRET=

# ---- 限流 ----
DAILY_LIMIT=5
LOGIN_LIMIT=10
