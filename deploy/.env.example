# 一键部署配置：复制为 .env 后修改（deploy.sh 首次运行会自动复制）

# ---- 站点入口 ----
# docker-compose.override.yml 仅绑定宿主回环地址；公网入口由 Nginx Proxy Manager 提供
HTTP_PORT=8080

# ---- 数据库（复用现有 mysql-common 容器）----
DB_HOST=mysql-common
DB_PORT=3306
DB_USER=zhongju
DB_PASSWORD=请改成强密码
DB_NAME=zhongju_cards

# MySQL 与 Nginx Proxy Manager 共用的桥接网络，按目标环境填写
SHARED_NETWORK=bridge-network

# 仅首次建库时使用；建库完成后可留空
MYSQL_ROOT_PASSWORD=

# ---- 首个主管理员账号 ----
# 仅在首次部署时由 init-admin 脚本创建（幂等：已存在则跳过），建好后建议从 .env 删除密码
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=请改成主管理员密码
INIT_ADMIN_NAME=主管理员

# ---- 登录会话与限流 ----
# 登录会话有效期（小时）
TOKEN_EXPIRE_HOURS=12
# 每个账号每天可生成的名片数
DAILY_LIMIT=5
# 同一 IP 每小时登录尝试上限
LOGIN_LIMIT=10
QUOTA_TIME_ZONE=Asia/Shanghai
# 仅适用于项目 Nginx 已清洗转发头的 Docker 代理链；直接运行 API 时使用 false
TRUST_PROXY=loopback,uniquelocal
