# 一键部署配置：复制为 .env 后修改（deploy.sh 首次运行会自动复制）

# ---- 对外访问 ----
# 宿主机端口：80 直接对外；若服务器已有 Nginx/宝塔占用 80，改成 8080 再由宿主反代
HTTP_PORT=80

# ---- 数据库（复用现有 mysql-common 容器）----
DB_HOST=mysql-common
DB_PORT=3306
DB_USER=zhongju
DB_PASSWORD=请改成强密码
DB_NAME=zhongju_cards

# 现有桥接网络名（docker network ls 查看，通常是 bridge 或 1panel-network）
SHARED_NETWORK=bridge-network

# 仅首次建库时使用；建库完成后可留空
MYSQL_ROOT_PASSWORD=

# ---- 双口令（务必改掉默认值）----
STAFF_TOKEN=请改成业务员口令
ADMIN_TOKEN=请改成管理员口令
# token 签名密钥，建议填 32 位随机字符串：openssl rand -hex 16
TOKEN_SECRET=

# ---- 限流 ----
DAILY_LIMIT=5
LOGIN_LIMIT=10
