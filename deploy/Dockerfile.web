# 前端静态站 + Nginx（多阶段构建：容器内编译，服务器无需安装 Node）
FROM node:24-alpine AS build

WORKDIR /app

# 依赖层缓存
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# 服务端模式（/api 同域反代，故 API 基地址留空）
ARG VITE_CARD_SERVER=on
ARG VITE_CARD_API_BASE=
ENV VITE_CARD_SERVER=$VITE_CARD_SERVER \
    VITE_CARD_API_BASE=$VITE_CARD_API_BASE

RUN npm run build

# Pin the version: registry mirrors may retain stale moving tags.
FROM nginx:1.30.6-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
