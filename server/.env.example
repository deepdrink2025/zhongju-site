# 复制为 .env 后修改（生产环境务必全部改掉默认口令）

# ---- 数据库（连接公共 MySQL 容器）----
DB_HOST=mysql-common
DB_PORT=3306
DB_USER=zhongju
DB_PASSWORD=改成你的数据库密码
DB_NAME=zhongju_cards

# ---- 双口令分层 ----
# 业务员口令：在 /create 登录，只能创建/管理自己的名片
STAFF_TOKEN=zhongju2026
# 管理员口令：在 /admin 登录，可看全部名片、停用、删除
ADMIN_TOKEN=改成你的管理员口令
# token 签名密钥（不设置则由上面两个口令派生；建议单独设置随机字符串）
TOKEN_SECRET=

# ---- 限流 ----
# 单 IP 每日创建上限
DAILY_LIMIT=5
# 单 IP 每 10 分钟登录尝试上限
LOGIN_LIMIT=10

# ---- 部署 ----
# 现有桥接网络名：docker network ls 查看
SHARED_NETWORK=bridge-network
