# 复制为 .env 后修改（生产环境务必改掉默认密码）

# ---- 数据库（连接公共 MySQL 容器）----
DB_HOST=mysql-common
DB_PORT=3306
DB_USER=zhongju
DB_PASSWORD=改成你的数据库密码
DB_NAME=zhongju_cards

# ---- 首个主管理员（由 init-admin 脚本创建，幂等）----
# node sql/init-admin.mjs 读取以下变量；建好后可自行在后台改密码
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=请改成主管理员密码
INIT_ADMIN_NAME=主管理员

# ---- 会话与限流 ----
# 登录会话有效期（小时）
TOKEN_EXPIRE_HOURS=12
# 单账号每日名片生成上限
DAILY_LIMIT=5
# 单 IP 每 10 分钟登录尝试上限
LOGIN_LIMIT=10
QUOTA_TIME_ZONE=Asia/Shanghai
TRUST_PROXY=false

# ---- 部署 ----
# 现有桥接网络名：docker network ls 查看
SHARED_NETWORK=bridge-network
